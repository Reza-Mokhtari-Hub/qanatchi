# ==============================================================================
# QANATCHI — Environment Variable Reference (NO SECRETS COMMITTED)
# ==============================================================================

# --- Frontend Build Configuration (Vite public variables only; NEVER put secrets here) ---
# Deployment base path ("/" for root domain, or "/subpath/" if hosted under a subpath)
VITE_BASE_PATH="/"

# Optional ArvanCloud Edge API base URL. Leave empty for same-origin "/api/v1/*" routing.
# Primary variable:
VITE_EDGE_API_URL=""
# Backward-compatible alias:
VITE_API_BASE_URL=""

# --- ArvanCloud Edge Computing Dashboard Environment Variables ---
# Configure these in ArvanCloud Dashboard -> Edge Computing -> Application -> Environment Variables.
# Mark all secrets/credentials as Encrypted Variables in the ArvanCloud Dashboard.
# Note: EC_URL is a reserved ArvanCloud Edge runtime variable; do not overwrite it.

# Environment name returned non-sensitively in /api/v1/health ("production" | "staging")
APP_ENV="production"

# Comma-separated explicit origin allowlist for cross-origin API requests (never use "*")
# Example: "https://qanatchi.example.ir,https://www.qanatchi.example.ir"
ALLOWED_ORIGINS=""

# Durable leaderboard storage configuration:
# Option A (Free / zero-container): Set LEADERBOARD_STORAGE_DRIVER="neon-http" and put your Neon
#   "postgresql://..." connection string in LEADERBOARD_DATABASE_URL (Encrypted).
# Option B (ArvanCloud DBaaS + gateway): Set LEADERBOARD_STORAGE_DRIVER="postgres-http",
#   LEADERBOARD_DATABASE_URL="https://<gateway-domain>", and LEADERBOARD_DATABASE_TOKEN="<GATEWAY_AUTH_TOKEN>".
# Leave empty to operate in honest 503 STORAGE_NOT_CONFIGURED mode while keeping health,
# daily metadata, attempt tokens, and server-side solution replay active.
LEADERBOARD_STORAGE_DRIVER=""
LEADERBOARD_DATABASE_URL=""
LEADERBOARD_DATABASE_TOKEN=""
# Legacy alias accepted if LEADERBOARD_DATABASE_TOKEN is omitted:
LEADERBOARD_DATABASE_PASSWORD=""

# HMAC-SHA256 secret (32+ random hex/ascii chars) used to sign anti-cheat attempt tokens.
EDGE_SIGNING_SECRET=""

# Set to "true" in strict ranked mode to require a signed single-use attemptToken on /leaderboards/submit.
REQUIRE_ATTEMPT_TOKEN="false"

# Per-player / per-IP sliding window limit per minute for write endpoints (default: 60).
RATE_LIMIT_MAX_PER_MIN="60"

# Structured single-line JSON request logs on ArvanCloud Edge Console ("true" | "false").
ENABLE_STRUCTURED_LOGS="true"

# --- Postgres HTTP SQL Gateway (scripts/postgres-http-gateway.mjs) ---
# Used ONLY when running the standalone HTTPS SQL gateway in front of ArvanCloud Managed PostgreSQL.
GATEWAY_PORT="8080"
DATABASE_URL=""
GATEWAY_AUTH_TOKEN=""
DB_SSL="true"
