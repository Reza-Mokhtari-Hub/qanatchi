# ==============================================================================
# QANATCHI — Environment Variable Reference (NO SECRETS COMMITTED)
# ==============================================================================

# --- Frontend Build Configuration (Vite public variables only; NEVER put secrets here) ---
# Deployment base path ("/" for root domain, or "/subpath/" if hosted under a subpath)
VITE_BASE_PATH="/"

# Optional Edge API base URL. Leave empty for same-origin "/api/v1/*" routing on ArvanCloud Edge.
VITE_API_BASE_URL=""

# --- ArvanCloud Edge Computing Dashboard Environment Variables ---
# Configure these in ArvanCloud Dashboard -> Edge Computing -> Application -> Environment Variables.
# Mark all secrets/credentials as Encrypted Variables in the ArvanCloud Dashboard.
# Note: EC_URL is a reserved ArvanCloud Edge runtime variable; do not overwrite it.

# Environment name returned non-sensitively in /api/v1/health ("production" | "staging")
APP_ENV="production"

# Comma-separated explicit origin allowlist for cross-origin API requests (never use "*")
# Example: "https://qanatchi.example.ir,https://www.qanatchi.example.ir"
ALLOWED_ORIGINS=""

# Durable leaderboard storage configuration (ONLY set after provisioning a verified
# Edge-compatible HTTPS/REST database gateway or supported persistent store).
# Leave unset to operate in honest STORAGE_NOT_CONFIGURED mode while keeping health,
# daily metadata, and server-side challenge verification active.
LEADERBOARD_STORAGE_DRIVER=""
LEADERBOARD_DATABASE_URL=""
LEADERBOARD_DATABASE_USER=""
LEADERBOARD_DATABASE_PASSWORD=""
EDGE_SIGNING_SECRET=""
